# ---- MySQL connection used by the API (least-privilege account from 06_security.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mall_db
DB_USER=mall_app
DB_PASSWORD=MallApp#2024

# ---- Read-only account used by the SQL console and table browser
DB_READONLY_USER=mall_readonly
DB_READONLY_PASSWORD=MallRead#2024

# ---- Authentication (generate a long random secret for real use:
#      python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# ---- Comma-separated list of allowed browser origins (only needed when the
#      frontend dev server runs on a different port)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
